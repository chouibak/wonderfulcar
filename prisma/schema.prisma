generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Car {
  id           Int      @id @default(autoincrement())
  name         String
  category     String
  price        Int
  transmission String
  seats        Int
  fuel         String
  bags         Int
  image        String
  badge        String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSettings {
  id              Int      @id @default(1)
  brandName       String
  brandAccent     String   @default("")
  logoIcon        String   @default("")
  logoUrl         String   @default("")
  phone           String
  whatsapp        String
  email           String
  address         String
  city            String   @default("")
  mapUrl          String
  metaTitle       String
  metaDescription String   @default("")
  heroBadge       String   @default("")
  heroDescription String   @default("")
  openingHours    String   @default("")
  heroVideoUrl    String   @default("")
  footerTagline   String   @default("")
  contactTitle    String   @default("")
  updatedAt       DateTime @updatedAt
}
