# =============================================================================
# LOCAL DEVELOPMENT (.env on your PC)
# =============================================================================
# Use Neon/Supabase OR your VPS Postgres if port 5432 is exposed publicly.

DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-xxxxx.aws.neon.tech/neondb?sslmode=require"

ADMIN_PASSWORD="1234admin"
ADMIN_SESSION_TOKEN="wc-admin-session-secret-2026"


# =============================================================================
# VPS / EASYPANEL (set in EasyPanel → App service → Environment)
# =============================================================================
# Do NOT use localhost. Copy INTERNAL host from:
#   EasyPanel → Postgres service → Credentials
#
# Example (replace PASSWORD and verify HOST + DB name in EasyPanel):
#
# DATABASE_URL="postgresql://postgres:PASSWORD@landing-page-web_general-car:5432/general-car?sslmode=disable"
#
# If that host fails, try the exact hostname shown in EasyPanel, e.g.:
# DATABASE_URL="postgresql://postgres:PASSWORD@landing-page-web_genera-lcar:5432/general-car?sslmode=disable"
#
# EasyPanel start command for the app:
#   npm run build && npm run start:prod
#
# Test after deploy:
#   https://your-domain.com/api/health
